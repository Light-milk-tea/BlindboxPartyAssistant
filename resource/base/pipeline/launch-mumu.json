{
    "LaunchMuMu": {
        "recognition": "DirectHit",
        "action": "Shell",
        "cmd": "pidof com.palmpi.matrix.yofun.mumu",
        "shell_timeout": 5000,
        "focus": {
            "Node.Action.Succeeded": "游戏已在运行，跳过启动 MuMu"
        },
        "on_error": [
            "LaunchMuMuReady"
        ]
    },
    "LaunchMuMuReady": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "focus": {
            "Node.Action.Succeeded": "MuMu 已就绪"
        }
    }
}
