{
    "Idle": {
        "recognition": "DirectHit",
        "action": "Command",
        "exec": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "{RESOURCE_DIR}/idle-budget.ps1",
            "start",
            "0"
        ],
        "next": [
            "IdleLoop"
        ]
    },
    "IdleLoop": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "rate_limit": 1000,
        "timeout": 20000,
        "next": [
            "[JumpBack]OfflineSeen",
            "IdleClickChallenge",
            "IdleClickReady",
            "IdleDismissLevel",
            "IdleInBattle",
            "IdleEnter"
        ]
    },
    "IdleDismissLevel": {
        "recognition": "TemplateMatch",
        "template": "idle/level.png",
        "roi": [
            360,
            70,
            560,
            180
        ],
        "threshold": 0.7,
        "action": "Click",
        "target": true,
        "post_delay": 1000,
        "focus": {
            "Node.Action.Succeeded": "关闭等级提升"
        },
        "next": [
            "IdleCheckTime"
        ]
    },
    "IdleClickReady": {
        "recognition": "TemplateMatch",
        "template": [
            "idle/ready.png",
            "idle/ready_dark.png"
        ],
        "roi": [
            1000,
            600,
            280,
            120
        ],
        "threshold": 0.75,
        "action": "Click",
        "target": true,
        "post_delay": 1500,
        "focus": {
            "Node.Action.Succeeded": "点击挑战"
        },
        "next": [
            "IdleCheckTime"
        ]
    },
    "IdleClickChallenge": {
        "recognition": "TemplateMatch",
        "template": "idle/challenge.png",
        "roi": [
            620,
            520,
            420,
            180
        ],
        "threshold": 0.8,
        "action": "Click",
        "target": true,
        "post_delay": 1500,
        "focus": {
            "Node.Action.Succeeded": "点击立即挑战"
        },
        "next": [
            "IdleCheckTime"
        ]
    },
    "IdleInBattle": {
        "recognition": "TemplateMatch",
        "template": "idle/hall.png",
        "roi": [
            990,
            0,
            280,
            80
        ],
        "threshold": 0.8,
        "action": "DoNothing",
        "post_delay": 1000,
        "next": [
            "IdleCheckTime"
        ]
    },
    "IdleEnter": {
        "recognition": "TemplateMatch",
        "template": "idle/enter.png",
        "roi": [
            860,
            400,
            360,
            140
        ],
        "threshold": 0.8,
        "action": "Click",
        "target": true,
        "post_delay": 1500,
        "focus": {
            "Node.Action.Succeeded": "进入放置作战"
        },
        "next": [
            "IdleCheckTime"
        ]
    },
    "IdleCheckTime": {
        "recognition": "DirectHit",
        "action": "Command",
        "exec": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "{RESOURCE_DIR}/idle-budget.ps1",
            "check"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "IdleLoop"
        ],
        "on_error": [
            "IdleTimeUp"
        ]
    },
    "IdleTimeUp": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "focus": {
            "Node.Action.Succeeded": "放置挂机时间到"
        }
    }
}
